{
  "manifest_version": 3,
  "name": "Meeting Bridge · 会议提问助手",
  "version": "0.6.2",
  "description": "实时转写和中文翻译，划选英文追加到 ChatGPT、DeepSeek 或千问网页草稿。",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "sidePanel",
    "clipboardWrite",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://www.qianwen.com/*",
    "https://qianwen.com/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Meeting Bridge"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "panel.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
